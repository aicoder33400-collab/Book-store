generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  USER
}

enum LoanStatus {
  REQUESTED
  APPROVED
  REJECTED
  BORROWED
  RETURN_REQUESTED
  RETURNED
  LATE
}

enum PrayerSlot {
  DOHR
  ASR
  MAGHREB
}

enum CopyStatus {
  AVAILABLE
  BORROWED
  LOST
  DAMAGED
}

enum BookGenre {
  CORAN
  TAFSIR
  HADITH
  FIQH
  AQIDA
  SIRA
  SUNNA
  SPIRITUALITE
  HISTOIRE_ISLAMIQUE
  LANGUE_ARABE
  EDUCATION_ENFANTS
  BIOGRAPHIE_SAVANTS
  DIVERS
}

enum BookLanguage {
  ARABE
  FRANCAIS
  ARABE_FRANCAIS
  ANGLAIS
  AUTRE
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  phone             String?
  emailVerified     Boolean   @default(false)
  password          String?
  role              UserRole  @default(USER)
  googleId          String?   @unique
  avatar            String?
  authProvider      String    @default("local")
  firstName         String?
  lastName          String?
  age               Int?
  commune           String?
  isProfileComplete Boolean   @default(false)
  lastLoginAt       DateTime?
  verificationCode  String?
  resetCode         String?
  resetCodeExpires  DateTime?
  loans             Loan[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("users")
}

model Book {
  id                String    @id @default(uuid())
  title             String
  author            String
  description       String?
  isForRent         Boolean   @default(true)
  imageUrl          String?
  totalCopies       Int       @default(1)
  genre             BookGenre @default(AUTRE)
  language          BookLanguage @default(FRANCAIS)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  copies            Copy[]

  @@map("books")
}

model Copy {
  id                String    @id @default(uuid())
  bookId            String
  copyNumber        Int
  status            CopyStatus @default(AVAILABLE)
  
  book              Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  loans             Loan[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([bookId, copyNumber])
  @@map("copies")
}

model Loan {
  id                String       @id @default(uuid())
  userId            String
  copyId            String
  borrowedAt        DateTime     @default(now())
  dueDate           DateTime
  returnedAt        DateTime?
  status            LoanStatus   @default(BORROWED)
  
  pickupDate        DateTime?
  pickupPrayer      PrayerSlot?

  returnPickupDate     DateTime?
  returnPickupPrayer   PrayerSlot?

  
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  copy              Copy         @relation(fields: [copyId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
  @@index([copyId])
  @@index([status])
  @@map("loans")
}
